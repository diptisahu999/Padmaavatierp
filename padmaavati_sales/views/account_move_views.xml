<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Customer Invoice Form to add SAP Code column in Invoice Lines -->
    <record id="view_move_form_inherit_sap_code" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sap.code</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="after">
                <field name="sap_code" optional="show"/>
                <field name="part_number" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
