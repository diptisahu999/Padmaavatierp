<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order Form to add Transport & E-Way Bill Details -->
    <record id="purchase_order_form_inherit_transport" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.transport</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Transport &amp; E-Way Bill" name="transport_details">
                    <group>
                        <!-- Group 1: Exact match with E-Way Bill TRANSPORTER DETAILS -->
                        <group string="TRANSPORTER DETAILS" name="transporter_details">
                            <field name="transport_id" string="Transporter" placeholder="Select Transporter" options="{'no_create_edit': False}"/>
                            <field name="transporter_id" invisible="1"/>
                        </group>

                        <!-- Group 2: Exact match with E-Way Bill TRANSPORTATION DETAILS (PART B) -->
                        <group string="TRANSPORTATION DETAILS (PART B)" name="transportation_details_part_b">
                            <field name="transportation_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="vehicle_type" invisible="transportation_mode not in ('1', '4')"/>
                            <field name="vehicle_no" placeholder="e.g. MH04 AB 1234"/>
                            <field name="tempo_no" invisible="1"/>
                            <field name="transport_vehicle_id" string="Select Registered Vehicle" domain="[('transport_id', '=', transport_id)] if transport_id else []"/>
                            <field name="vehicle_name" placeholder="e.g. Tata Ace, Bolero Pickup"/>
                            <label for="distance"/>
                            <div class="o_row">
                                <field name="distance"/>
                                <span>km</span>
                            </div>
                        </group>
                    </group>

                    <group>
                        <!-- Group 3: Consignment & LR Details -->
                        <group string="Consignment &amp; LR Details" name="consignment_details">
                            <field name="lr_no" placeholder="e.g. LR-123456"/>
                            <field name="lr_date"/>
                            <field name="parcel_qty" placeholder="Number of boxes/parcels"/>
                            <label for="lr_amount"/>
                            <div class="o_row">
                                <field name="lr_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <span class="text-muted small ps-2">(Info only - does not affect invoice total or accounts)</span>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order List to add LR No, Vehicle No and Transport as optional columns -->
    <record id="purchase_order_tree_inherit_transport" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.transport</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="transport_name" optional="hide"/>
                <field name="vehicle_no" optional="hide"/>
                <field name="transportation_mode" optional="hide"/>
                <field name="vehicle_type" optional="hide"/>
                <field name="lr_no" optional="hide"/>
                <field name="parcel_qty" optional="hide"/>
                <field name="lr_amount" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
